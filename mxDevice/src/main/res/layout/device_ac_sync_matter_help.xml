<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/core_color_background_main"
    android:orientation="vertical">

    <com.mxchip.mxapp.base.widget.TopBarView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/core_color_background_tab"
        app:layout_constraintTop_toTopOf="parent"
        app:title_text="@string/mx_faq" />

    <TextView
        android:id="@+id/tv_desc"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="12dp"
        android:padding="16dp"
        android:background="@drawable/core_bg_solid_white_r16"
        android:text="@string/mx_matter_faq"
        android:lineSpacingExtra="10dp"
        android:textColor="@color/core_color_text_dialog_content"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />
</LinearLayout>