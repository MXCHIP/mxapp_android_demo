<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/core_color_background_main">

    <com.mxchip.mxapp.base.widget.TopBarView
        android:id="@+id/toolbar"
        tools:title_text="列表"
        app:right_text="@string/mx_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_ccsmart_in"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/ccsmart_in"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:layout_marginStart="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:textColor="@color/core_color_text_list_content"
                    android:text="@string/ccs_device_show"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/ccsmart_in_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@id/ccsmart_in"/>

                <TextView
                    android:id="@+id/ccsmart_in_empty"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="parent"
                    android:textColor="@color/core_color_text_list_content"
                    android:text="@string/mx_will_add"
                    android:gravity="center"
                    app:layout_constraintTop_toBottomOf="@id/ccsmart_in"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    android:background="@color/core_color_background_list"/>

            </androidx.constraintlayout.widget.ConstraintLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_out"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/cl_ccsmart_in">

                <TextView
                    android:id="@+id/ccsmart_out"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:textColor="@color/core_color_text_list_content"
                    android:text="@string/mx_room_device_out"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/ccsmart_out_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@id/ccsmart_out"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>