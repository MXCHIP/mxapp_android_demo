<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/core_color_background_main"
    android:orientation="vertical">

    <com.mxchip.mxapp.base.widget.TopBarView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_text="@string/mx_device_detail"
        android:background="@color/core_color_background_tab"
        app:layout_constraintTop_toTopOf="parent" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp">

        <com.mxchip.mxapp.base.widget.ShapeableConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            app:layout_constraintTop_toTopOf="parent"
            app:radius="16"
            app:solid="@color/core_color_background_list">

            <ImageView
                android:id="@+id/iv_device_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="17dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_nick_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:ellipsize="end"
                android:maxWidth="240dp"
                android:maxLines="1"
                android:textColor="@color/core_color_text_title"
                android:textSize="16sp"
                app:layout_constraintBottom_toTopOf="@id/tv_device_add_time"
                app:layout_constraintStart_toEndOf="@id/iv_device_icon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                tools:text="温度传感器" />

            <TextView
                android:id="@+id/tv_device_add_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/core_color_text_list_content"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@id/tv_nick_name"
                app:layout_constraintTop_toBottomOf="@id/tv_nick_name"
                tools:text="加入时间 2021-1-21" />

        </com.mxchip.mxapp.base.widget.ShapeableConstraintLayout>

        <com.mxchip.mxapp.base.widget.ShapeableLinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            app:radius="16"
            app:solid="@color/core_color_background_list">

            <com.mxchip.mxapp.base.widget.CommonItemView
                android:id="@+id/item_device_identify"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                app:niv_text="@string/mx_device_id"
                app:text_color="@color/core_color_text_title" />

            <com.mxchip.mxapp.base.widget.CommonItemView
                android:id="@+id/item_product_identify"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                app:niv_text="@string/mx_product_key"
                app:text_color="@color/core_color_text_title" />

            <com.mxchip.mxapp.base.widget.CommonItemView
                android:id="@+id/item_device_mac"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                app:niv_text="@string/mx_mac"
                app:text_color="@color/core_color_text_title" />

            <com.mxchip.mxapp.base.widget.CommonItemView
                android:id="@+id/item_ota_update"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                app:niv_text="@string/mx_firmware_version"
                app:text_color="@color/core_color_text_title" />

            <com.mxchip.mxapp.base.widget.CommonItemView
                android:id="@+id/item_mcu"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                app:niv_text="@string/mx_mcu_version"
                app:text_color="@color/core_color_text_title" />

            <com.mxchip.mxapp.base.widget.CommonItemView
                android:id="@+id/item_feedback"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                app:end_icon="@drawable/core_ic_arrow_right"
                app:niv_text="@string/mx_feedback"
                app:text_color="@color/core_color_text_title" />

        </com.mxchip.mxapp.base.widget.ShapeableLinearLayout>

        <TextView
            android:id="@+id/btn_delete"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/core_bg_solid_white_r22"
            android:gravity="center"
            android:text="@string/mx_del_device"
            android:textColor="@color/core_color_error"
            android:textSize="17sp" />

    </LinearLayout>
</LinearLayout>
