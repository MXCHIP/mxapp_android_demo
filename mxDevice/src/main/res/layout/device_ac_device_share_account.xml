<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/core_color_white_to_black">

    <com.mxchip.mxapp.base.widget.TopBarView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:right_text="@string/device_submit"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="20dp"
        android:text="@string/mx_device_share"
        android:textColor="@color/core_color_text_title"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <View
        android:id="@+id/account_bg"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/core_bg_input_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title" />

    <FrameLayout
        android:id="@+id/account_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@id/account_bg"
        app:layout_constraintStart_toStartOf="@id/account_bg"
        app:layout_constraintTop_toTopOf="@id/account_bg">

        <TextView
            android:id="@+id/tv_selected_region"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="(+86)"
            android:textColor="@color/core_color_text_list_content"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/iv_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:src="@drawable/device_ic_email"
            android:visibility="gone" />

    </FrameLayout>

    <EditText
        android:id="@+id/et_account"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:background="@null"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="@color/core_color_text_title"
        android:textColorHint="@color/core_color_bfbfbf_to_40ffffff"
        android:textCursorDrawable="@drawable/core_bg_edittext_cursor"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@id/clear_text"
        app:layout_constraintStart_toEndOf="@id/account_type"
        app:layout_constraintTop_toTopOf="@id/account_bg"
        tools:hint="@string/mx_account_phone_hint" />

    <ImageView
        android:id="@+id/clear_text"
        android:layout_width="30dp"
        android:layout_height="50dp"
        android:paddingEnd="15dp"
        android:src="@drawable/core_ic_input_clear"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/et_account"
        app:layout_constraintEnd_toEndOf="@id/account_bg"
        app:layout_constraintTop_toTopOf="@id/et_account" />

</androidx.constraintlayout.widget.ConstraintLayout>