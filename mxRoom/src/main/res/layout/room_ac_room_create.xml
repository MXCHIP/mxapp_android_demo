<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/core_color_background_main"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.mxchip.mxapp.base.widget.TopBarView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_text="@string/mx_add_room"
        app:right_text="@string/mx_save"
        android:id="@+id/toolbar"
        app:layout_constraintTop_toTopOf="parent"/>

    <LinearLayout
        android:id="@+id/ll_room_name"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        android:layout_marginTop="12dp"
        android:background="@color/core_color_background_tab">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mx_room_name"
            android:textSize="16sp"
            android:textColor="@color/core_color_text_title"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="16dp"/>

        <EditText
            android:id="@+id/et_room_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/mx_input_room_name"
            android:imeOptions="actionDone|actionNext"
            android:inputType="text"
            android:maxLines="1"
            android:padding="8dp"
            android:scrollHorizontally="true"
            android:textColor="@color/core_color_text_title"
            android:textSize="16sp"
            android:layout_marginStart="16dp"
            android:layout_gravity="center_vertical"
            android:background="@color/transparent"
            tools:visibility="visible" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_recommend_room"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mx_room_recommend"
        android:textSize="12sp"
        android:textColor="@color/core_color_text_list_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/ll_room_name"/>

    <com.mxchip.mxapp.base.widget.FlowLayout
        android:id="@+id/room_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>

</LinearLayout>