<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="482dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:clickable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.mxchip.mxapp.base.widget.ShapeableConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="412dp"
            app:layout_constraintTop_toTopOf="parent"
            app:solid="@color/core_color_background_tab"
            app:radius="20">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/core_color_text_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:text="@string/mx_join_family_scan"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="24dp"/>

            <TextView
                android:id="@+id/tv_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/core_color_text_dialog_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="@string/mx_join_family_des"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_title"
                android:layout_marginTop="8dp"/>

            <ImageView
                android:id="@+id/iv_qrcode"
                android:layout_width="180dp"
                android:layout_height="180dp"
                app:layout_constraintTop_toBottomOf="@id/tv_desc"
                android:layout_marginTop="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/tv_expire_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/core_color_text_dialog_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="@string/mx_join_family_qrcode_exp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iv_qrcode"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/tv_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:text="@string/mx_refresh"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_expire_desc"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/tv_scan_use"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/core_color_text_dialog_content"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="请使用app的扫一扫"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/tv_refresh"
                android:layout_marginTop="24dp" />

        </com.mxchip.mxapp.base.widget.ShapeableConstraintLayout>

        <ImageView
            android:id="@+id/close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/core_ic_close"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="@color/core_color_background_fifth" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>