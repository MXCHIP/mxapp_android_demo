<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/account_color_white_to_black"
    android:orientation="vertical">

    <com.mxchip.mxapp.base.widget.TopBarView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:text="@string/mx_set_password"
        android:textColor="@color/core_color_text_title"
        android:textSize="24sp"
        android:textStyle="bold" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp">

        <EditText
            android:id="@+id/login_pwd"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            android:background="@drawable/core_bg_input_text"
            android:cursorVisible="true"
            android:drawableStart="@drawable/account_ic_password"
            android:drawablePadding="12dp"
            android:gravity="center_vertical"
            android:hint="@string/mx_enter_password"
            android:inputType="textPassword"
            android:paddingStart="19dp"
            android:textColor="@color/core_color_text_title"
            android:textColorHint="@color/account_color_bfbfbf"
            android:textCursorDrawable="@drawable/core_bg_edittext_cursor"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/pwd_hide"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="24dp"
            android:src="@drawable/account_ic_password_hide"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/login_pwd"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="32dp">

        <EditText
            android:id="@+id/login_pwd2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            android:background="@drawable/core_bg_input_text"
            android:cursorVisible="true"
            android:drawableStart="@drawable/account_ic_password"
            android:drawablePadding="12dp"
            android:gravity="center_vertical"
            android:hint="@string/mx_confirm_password"
            android:inputType="textPassword"
            android:paddingStart="19dp"
            android:textColor="@color/core_color_text_title"
            android:textColorHint="@color/account_color_bfbfbf"
            android:textCursorDrawable="@drawable/core_bg_edittext_cursor"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/pwd_hide2"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="24dp"
            android:src="@drawable/account_ic_password_hide"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/login_pwd2"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tv_pwd_valid_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="24dp"
        android:text="@string/mx_password_valid_format"
        android:textColor="@color/core_color_text_list_content"
        android:textSize="12sp" />

    <com.mxchip.mxapp.base.widget.ShapeableButton
        android:id="@+id/next"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="25dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="25dp"
        android:alpha="0.4"
        android:enabled="false"
        android:text="@string/mx_confirm"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        app:sbRadius="25" />

</LinearLayout>