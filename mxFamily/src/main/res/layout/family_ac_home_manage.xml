<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/core_color_background_main">

    <com.mxchip.mxapp.base.widget.TopBarView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title_text="@string/mx_home_manage" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/family_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_bg_view"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <View
        android:id="@+id/bottom_bg_view"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/core_color_background_tab"
        app:layout_constraintBottom_toBottomOf="parent" />

    <LinearLayout
        android:id="@+id/create_family"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="@id/bottom_bg_view"
        app:layout_constraintEnd_toStartOf="@id/join_family"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/bottom_bg_view">

        <ImageView
            android:id="@+id/iv_create_family"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/family_ic_create_home" />

        <TextView
            android:id="@+id/tv_create_family"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/mx_create_family"
            android:textSize="18sp" />
    </LinearLayout>

    <View
        android:id="@+id/line"
        android:layout_width="1dp"
        android:layout_height="30dp"
        android:layout_gravity="center_vertical"
        android:background="@color/core_color_dividers"
        app:layout_constraintBottom_toBottomOf="@id/bottom_bg_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/bottom_bg_view" />

    <LinearLayout
        android:id="@+id/join_family"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="@id/bottom_bg_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/create_family"
        app:layout_constraintTop_toTopOf="@id/bottom_bg_view">

        <ImageView
            android:id="@+id/iv_join_family"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/family_ic_join_family" />

        <TextView
            android:id="@+id/tv_join_family"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/mx_join_family"
            android:textSize="18sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>