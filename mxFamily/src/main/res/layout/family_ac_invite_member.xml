<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/core_color_background_main">

    <com.mxchip.mxapp.base.widget.TopBarView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title_text="@string/mx_invite_member" />

    <com.mxchip.mxapp.base.widget.ShapeableConstraintLayout
        android:id="@+id/face_to_face_invite"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:radius="16"
        app:solid="@color/core_color_background_list">

        <ImageView
            android:id="@+id/iv_face_to_face_invite_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="16dp"
            android:background="#1a29a3ff"
            android:padding="6dp"
            android:scaleType="centerCrop"
            android:src="@drawable/family_ic_qrcode"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="68dp"
            android:text="@string/mx_invite_qrcode_member"
            android:textColor="@color/core_color_text_title"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/core_ic_arrow_right"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </com.mxchip.mxapp.base.widget.ShapeableConstraintLayout>

    <com.mxchip.mxapp.base.widget.ShapeableConstraintLayout
        android:id="@+id/code_invite"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/face_to_face_invite"
        app:radius="16"
        app:solid="@color/core_color_background_list">

        <ImageView
            android:id="@+id/iv_code_invite_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="16dp"
            android:background="#1a976ffb"
            android:padding="6dp"
            android:scaleType="centerCrop"
            android:src="@drawable/family_ic_code_invite"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="68dp"
            android:text="@string/mx_invite_code_member"
            android:textColor="@color/core_color_text_title"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/core_ic_arrow_right"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </com.mxchip.mxapp.base.widget.ShapeableConstraintLayout>

    <com.mxchip.mxapp.base.widget.ShapeableConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/code_invite"
        app:radius="16"
        app:solid="@color/core_color_background_list">

        <ImageView
            android:id="@+id/iv_account_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="14dp"
            android:background="#1afec60c"
            android:padding="6dp"
            android:scaleType="centerCrop"
            android:src="@drawable/family_ic_account_invite"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="68dp"
            android:text="@string/mx_invite_account_member"
            android:textColor="@color/core_color_text_title"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="@id/iv_account_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/iv_account_icon" />

        <View
            android:id="@+id/account_bg"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/core_bg_input_text"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_account_icon" />

        <FrameLayout
            android:id="@+id/account_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@id/account_bg"
            app:layout_constraintStart_toStartOf="@id/account_bg"
            app:layout_constraintTop_toTopOf="@id/account_bg">

            <TextView
                android:id="@+id/tv_selected_region"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="(+86)"
                android:textColor="@color/core_color_text_list_content"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/iv_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:src="@drawable/family_ic_email"
                android:visibility="gone" />

        </FrameLayout>

        <EditText
            android:id="@+id/et_account"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:background="@null"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="@color/core_color_text_title"
            android:textColorHint="@color/core_color_bfbfbf_to_40ffffff"
            android:textCursorDrawable="@drawable/core_bg_edittext_cursor"
            android:textSize="16sp"
            app:layout_constraintEnd_toStartOf="@id/clear_text"
            app:layout_constraintStart_toEndOf="@id/account_type"
            app:layout_constraintTop_toTopOf="@id/account_bg"
            tools:hint="@string/mx_account_phone_hint" />

        <ImageView
            android:id="@+id/clear_text"
            android:layout_width="30dp"
            android:layout_height="50dp"
            android:paddingEnd="15dp"
            android:src="@drawable/core_ic_input_clear"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/et_account"
            app:layout_constraintEnd_toEndOf="@id/account_bg"
            app:layout_constraintTop_toTopOf="@id/et_account" />

        <com.mxchip.mxapp.base.widget.ShapeableButton
            android:id="@+id/btn_invite"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:alpha="0.4"
            android:enabled="false"
            android:text="@string/mx_invite"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/account_bg"
            app:sbRadius="22" />

        <LinearLayout
            android:id="@+id/ll_wait_agree"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_invite">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/mx_invite_waiting"
                android:textColor="@color/core_color_text_dialog_content"
                android:textSize="12sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_share_in_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp" />

        </LinearLayout>

    </com.mxchip.mxapp.base.widget.ShapeableConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>