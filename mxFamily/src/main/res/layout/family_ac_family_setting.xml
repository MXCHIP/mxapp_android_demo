<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/core_color_background_main">

    <com.mxchip.mxapp.base.widget.TopBarView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title_text="@string/mx_family_setting" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.mxchip.mxapp.base.widget.CommonItemView
                android:id="@+id/family_name"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@color/core_color_background_list"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:niv_text="@string/mx_family_name" />

            <com.mxchip.mxapp.base.widget.CommonItemView
                android:id="@+id/family_location"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@color/core_color_background_list"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:niv_text="@string/mx_family_location" />

            <com.mxchip.mxapp.base.widget.CommonItemView
                android:id="@+id/room_manager"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@color/core_color_background_list"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:niv_text="@string/mx_room_manage" />

            <com.mxchip.mxapp.base.widget.CommonItemView
                android:id="@+id/device_count"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@color/core_color_background_list"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:niv_text="@string/mx_device_number" />

            <TextView
                android:id="@+id/tv_member"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:text="@string/mx_family_member"
                android:textColor="@color/core_color_text_list_content"
                android:textSize="14sp" />


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/member_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@color/core_color_background_list"
                android:overScrollMode="never" />

            <com.mxchip.mxapp.base.widget.CommonItemView
                android:id="@+id/hand_over"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="12dp"
                android:background="@color/core_color_background_list"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:end_icon="@drawable/core_ic_arrow_right"
                app:niv_text="@string/mx_role_hand_over" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>