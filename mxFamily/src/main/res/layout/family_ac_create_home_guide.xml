<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/core_color_background_list">


    <TextView
        android:id="@+id/home_manage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mx_home_manage"
        android:textSize="24sp"
        android:layout_marginTop="120dp"
        android:layout_marginStart="24dp"
        android:textColor="@color/core_color_text_title"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/home_name"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/core_bg_input_text"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/home_manage"
        tools:text="我的家"
        android:textSize="16sp"
        android:textColor="@color/core_color_text_title"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="40dp"
        android:maxLines="1"
        android:ellipsize="end"/>

    <ImageView
        android:id="@+id/iv_edit"
        android:layout_width="40dp"
        android:layout_height="50dp"
        android:paddingEnd="20dp"
        android:src="@drawable/family_ic_edit_underline"
        app:layout_constraintTop_toTopOf="@id/home_name"
        app:layout_constraintBottom_toBottomOf="@id/home_name"
        app:layout_constraintEnd_toEndOf="@id/home_name"
        tools:ignore="RtlSymmetry" />

    <TextView
        android:id="@+id/tv_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/home_name"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        android:textColor="@color/core_color_text_list_content"
        android:textSize="12sp"/>

    <com.mxchip.mxapp.base.widget.ShapeableButton
        android:id="@+id/btn_next"
        android:layout_width="match_parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_height="50dp"
        android:text="@string/mx_next"
        android:layout_marginTop="32dp"
        android:textColor="@color/core_color_background_fifth"
        android:textSize="17sp"
        app:sbRadius="25"
        app:layout_constraintTop_toBottomOf="@id/tv_desc"/>

    <TextView
        android:id="@+id/skip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textColor="@color/core_color_text_title"
        app:layout_constraintTop_toBottomOf="@id/btn_next"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>