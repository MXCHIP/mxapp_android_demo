<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/core_color_background_main">

    <com.mxchip.mxapp.base.widget.TopBarView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title_text="@string/mx_family_member" />

    <com.mxchip.mxapp.base.widget.CommonItemView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="12dp"
        android:background="@color/core_color_background_list"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:niv_text="@string/mx_name" />

    <FrameLayout
        android:id="@+id/layout_pic"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/core_color_background_list"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/name">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/mx_user_photo"
            android:textColor="@color/core_color_text_title"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/shap_iv_photo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical|end"
            app:shapeAppearanceOverlay="@style/circleImageStyle" />

    </FrameLayout>

    <com.mxchip.mxapp.base.widget.CommonItemView
        android:id="@+id/account"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/core_color_background_list"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/layout_pic"
        app:niv_text="@string/mx_user_account" />

    <com.mxchip.mxapp.base.widget.CommonItemView
        android:id="@+id/role"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/core_color_background_list"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/account"
        app:niv_text="@string/mx_role" />

    <TextView
        android:id="@+id/remove_member"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="12dp"
        android:background="@color/core_color_background_list"
        android:gravity="center"
        android:text="@string/mx_role_del_member"
        android:textColor="@color/core_color_error"
        android:textSize="17sp"
        app:layout_constraintTop_toBottomOf="@id/role" />

</androidx.constraintlayout.widget.ConstraintLayout>