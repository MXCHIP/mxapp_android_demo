<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.mxchip.mxapp.base.widget.TopBarView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title_text="@string/mx_invite_code_input" />

    <ImageView
        android:id="@+id/iv_member"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="48dp"
        android:src="@drawable/family_ic_add_member"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <TextView
        android:id="@+id/desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/mx_invite_code_input_admin"
        android:textColor="@color/core_color_text_title"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_member" />

    <com.mxchip.mxapp.base.widget.VerificationEditText
        android:id="@+id/et_verification_code"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:inputType="number"
        android:textColor="@color/core_color_text_title"
        android:textSize="28sp"
        android:textStyle="bold"
        app:inputMargin="10dp"
        app:inputRadius="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/desc" />

    <com.mxchip.mxapp.base.widget.ShapeableButton
        android:id="@+id/join"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        android:enabled="false"
        android:alpha="0.4"
        android:text="@string/mx_join_family"
        android:textAllCaps="false"
        app:sbRadius="25"
        android:textColor="@android:color/white"
        android:textSize="17sp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/et_verification_code"/>


</androidx.constraintlayout.widget.ConstraintLayout>