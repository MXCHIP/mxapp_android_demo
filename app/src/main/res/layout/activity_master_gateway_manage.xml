<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/core_color_background_main">

    <com.mxchip.mxapp.base.widget.TopBarView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/core_color_background_tab"
        app:layout_constraintTop_toTopOf="parent"
        app:title_text="@string/mx_gateway_manage" />

    <FrameLayout
        android:id="@+id/layout_family_name"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/core_color_background_tab"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <TextView
            android:id="@+id/tv_family_name"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="20dp"
            android:drawablePadding="4dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="@color/core_color_text_title"
            android:textSize="18sp"
            android:textStyle="bold"
            app:drawableRightCompat="@drawable/ic_swipe"
            tools:text="我的家我的" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_gateway_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:text="@string/mx_gateway_master_desc"
        android:textColor="@color/core_color_text_title"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_family_name" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_device"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_gateway_title"
        app:layout_goneMarginTop="20dp" />

    <com.mxchip.mxapp.base.widget.EmptyView
        android:id="@+id/empty_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        app:ev_content="@string/mx_gateway_list_no_data"
        app:layout_constraintBottom_toBottomOf="@id/rv_device"
        app:layout_constraintEnd_toEndOf="@id/rv_device"
        app:layout_constraintStart_toStartOf="@id/rv_device"
        app:layout_constraintTop_toTopOf="@id/rv_device" />

</androidx.constraintlayout.widget.ConstraintLayout>
