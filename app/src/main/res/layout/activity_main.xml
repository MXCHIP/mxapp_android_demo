<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/core_color_background_main">

    <View
        android:layout_width="match_parent"
        android:layout_height="480dp"
        android:background="@drawable/bg_ic_fragment_top"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_home_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/layout_family_name"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="104dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/family_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:drawablePadding="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:minWidth="3dp"
                android:textColor="@color/core_color_text_title"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="我的家我的" />
        </FrameLayout>

        <ImageView
            android:id="@+id/iv_notifications"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_notification"
            app:layout_constraintBottom_toBottomOf="@id/layout_family_name"
            app:layout_constraintEnd_toStartOf="@id/iv_add_small"
            app:layout_constraintTop_toTopOf="@id/layout_family_name"
            app:layout_goneMarginEnd="20dp"
            app:tint="@color/core_color_text_title" />

        <View
            android:id="@+id/notification_red_pointer"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_gravity="end"
            android:background="@drawable/core_ic_red_point"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/iv_notifications"
            app:layout_constraintTop_toTopOf="@id/iv_notifications" />

        <ImageView
            android:id="@+id/iv_add_small"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginEnd="20dp"
            android:src="@drawable/ic_add_round"
            app:layout_constraintBottom_toBottomOf="@id/layout_family_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/layout_family_name"
            app:tint="@color/core_color_text_title" />

        <TextView
            android:id="@+id/env_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="4dp"
            android:textColor="@color/core_color_warning"
            android:textSize="12sp"
            android:visibility="gone"
            app:drawableEndCompat="@drawable/core_ic_arrow_right"
            app:drawableTint="@color/core_color_warning"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_family_name"
            tools:text="测试环境" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/frame_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_home_info" />



</androidx.constraintlayout.widget.ConstraintLayout>