<?xml version="1.0" encoding="utf-8"?>
<com.mxchip.mxapp.base.widget.ShapeableConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    app:radius="16"
    app:solid="@color/core_color_background_list">

    <View
        android:id="@+id/execute_action"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/scene_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/scene_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:textColor="@color/core_color_text_title"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/iv_invalid"
        app:layout_constraintStart_toEndOf="@id/scene_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="8dp"
        tools:text="测试测试测试测试测试测试测试测试测试测试测试测试测试测试" />

    <ImageView
        android:id="@+id/iv_invalid"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/core_ic_progress_err"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</com.mxchip.mxapp.base.widget.ShapeableConstraintLayout>