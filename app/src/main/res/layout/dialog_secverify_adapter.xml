<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:gravity="center">

    <com.mxchip.mxapp.base.widget.ShapeableConstraintLayout
        android:layout_width="304dp"
        android:layout_height="320dp"
        app:radius="20"
        app:solid="@color/core_color_background_dialog">

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/core_ic_close"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="24dp"/>

        <TextView
            android:id="@+id/phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/core_color_text_title"
            android:textSize="32sp"
            android:textStyle="bold"
            tools:text="138****8888"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="66dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/core_color_text_dialog_content"
            android:textSize="14sp"
            tools:text="中国移动提供认证服务"
            app:layout_constraintTop_toBottomOf="@id/phone"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.mxchip.mxapp.base.widget.ShapeableLinearLayout
            android:id="@+id/login"
            android:layout_width="256dp"
            android:layout_height="44dp"
            app:radius="44"
            app:solid="@color/app_main_color"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="80dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mx_quick_login"
                android:textSize="17sp"
                android:textColor="@android:color/white"
                android:layout_gravity="center"/>

        </com.mxchip.mxapp.base.widget.ShapeableLinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/login"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="32dp"
            android:layout_marginStart="24dp">


            <ImageView
                android:id="@+id/iv_agree"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/core_ic_round_unselected"/>

            <TextView
                android:id="@+id/protocol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:layout_marginStart="5dp"
                tools:text="我已阅读并同意xxx"/>
        </LinearLayout>

    </com.mxchip.mxapp.base.widget.ShapeableConstraintLayout>

</LinearLayout>