<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/device_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/device_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:layout_marginStart="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/core_color_text_title"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/desc"
        app:layout_constraintEnd_toStartOf="@id/tv_failed"
        app:layout_constraintStart_toEndOf="@id/device_image"
        app:layout_constraintTop_toTopOf="@id/device_image"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Mesh-五路球泡灯" />

    <TextView
        android:id="@+id/desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingBottom="10dp"
        android:textColor="@color/core_color_text_list_content"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/device_image"
        app:layout_constraintEnd_toEndOf="@id/device_name"
        app:layout_constraintStart_toStartOf="@id/device_name"
        app:layout_constraintTop_toBottomOf="@id/device_name"
        tools:text="Mesh-五路球泡灯" />

    <TextView
        android:id="@+id/tv_failed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:layout_toStartOf="@id/iv_state"
        android:ellipsize="end"
        android:maxLines="1"
        tools:text="failed"
        android:textColor="@color/core_color_error"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/device_image"
        app:layout_constraintEnd_toStartOf="@id/iv_state"
        app:layout_constraintTop_toTopOf="@id/device_image" />

    <ImageView
        android:id="@+id/iv_state"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@id/device_image"
        app:layout_constraintEnd_toStartOf="@id/iv_failed"
        app:layout_constraintTop_toTopOf="@id/device_image"
        app:layout_goneMarginEnd="16dp" />

    <ImageView
        android:id="@+id/iv_failed"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/core_ic_arrow_right"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/device_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/device_image" />

</androidx.constraintlayout.widget.ConstraintLayout>